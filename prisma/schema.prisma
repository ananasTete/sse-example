generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Chat {
  id              String    @id
  userId          String    @default("local-user")
  title           String?
  cursorMessageId String?
  nextSeq         Int       @default(0)
  settingsJson    Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  messages        Message[]
  runs            ChatRun[]

  @@index([userId, updatedAt])
}

model Message {
  id        String   @id
  chatId    String
  parentId  String?
  role      String
  partsJson Json
  model     String?
  status    String
  seq       Int
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, seq])
  @@index([chatId, parentId, createdAt])
  @@unique([chatId, seq])
}

model ChatRun {
  id                 String        @id
  chatId             String
  userId             String
  assistantMessageId String
  parentMessageId    String?
  resumeToken        String
  status             String
  lastEventSeq       Int           @default(0)
  lastPersistedSeq   Int           @default(0)
  lastError          String?
  lastHeartbeatAt    DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  finishedAt         DateTime?
  chat               Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  events             ChatRunEvent[]

  @@index([chatId, status, createdAt])
  @@index([userId, status, createdAt])
}

model ChatRunEvent {
  id          String   @id
  runId       String
  seq         Int
  event       String
  payloadJson Json
  createdAt   DateTime @default(now())
  run         ChatRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@unique([runId, seq])
}

model ChatSession {
  id               String    @id
  seqId            Int       @unique
  agent            String    @default("chat")
  modelType        String    @default("default")
  title            String?
  titleType        String    @default("WIP")
  version          Int       @default(0)
  currentMessageId Int?
  nextMessageId    Int       @default(0)
  nextFragmentId   Int       @default(0)
  pinned           Boolean   @default(false)
  isEmpty          Boolean   @default(true)
  expiresAt        DateTime?
  insertedAt       DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  messages         ChatMessage[]

  @@index([updatedAt])
  @@index([pinned, updatedAt])
  @@index([expiresAt])
}

model ChatSequence {
  name  String @id
  value Int
}

model ChatMessage {
  id                    Int       @id @default(autoincrement())
  localId               Int
  chatSessionId         String
  parentId              Int?
  model                 String    @default("")
  role                  String
  thinkingEnabled       Boolean   @default(false)
  banEdit               Boolean   @default(false)
  banRegenerate         Boolean   @default(false)
  status                String
  incompleteMessage     String?
  accumulatedTokenUsage Int       @default(0)
  feedback              Json?
  searchEnabled         Boolean   @default(false)
  conversationMode      String    @default("DEFAULT")
  hasPendingFragment    Boolean   @default(false)
  autoContinue          Boolean   @default(false)
  insertedAt            DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  chatSession           ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  fragments             MessageFragment[]

  @@index([chatSessionId, insertedAt])
  @@index([chatSessionId, parentId])
  @@unique([chatSessionId, localId])
}

model MessageFragment {
  id             Int         @id @default(autoincrement())
  localId        Int
  messageId      Int
  type           String
  status         String?
  content        String?
  toolName       String?
  toolCallId     String?
  toolInputJson  Json?
  toolOutputJson Json?
  queriesJson    Json?
  resultsJson    Json?
  referencesJson Json?
  stageId        Int?
  insertedAt     DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  message        ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, id])
  @@unique([messageId, localId])
}
